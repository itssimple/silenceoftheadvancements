{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",

  "name": "${mod_name}",
  "description": "${description}",
  "authors": [ "${mod_author}" ],
  "contact": {
    "homepage": "",
    "sources": "https://github.com/itssimple/silenceoftheadvancements",
    "issues": "https://github.com/itssimple/.mod-issue-tracker/issues?q=state%3Aopen%20label%3A%22mod%3A%20Silence%20of%20the%20Advancements%22"
  },

  "license": "${license}",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": { "main": [
    "se.itssimple.${mod_id}.ModFabric"
  ] },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}-fabric.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}",
    "java": ">=${java_version}"
  }
}